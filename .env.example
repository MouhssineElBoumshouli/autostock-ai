# Copy this file to .env and change the values. .env is never committed to git.
# On a shop's computer, follow docs/INSTALL.md (it says which lines to change).

# Database login (used by the database, the app and the backups).
# On a shop's computer: at least 16 characters, never "change-me" or "autostock" (AutoStock refuses
# to start otherwise). Set it before the first start: the database keeps the password it was created with.
POSTGRES_USER=autostock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autostock

# --- Shop computer (docker-compose.prod.yml) ---
# Port of AutoStock on this computer: http://localhost:8080
APP_PORT=8080
# Not needed on a shop PC: a page saves fine at whatever address it was opened (localhost, the PC's
# IPv4 address, its name). Only list addresses here, separated by commas, if AutoStock is reached
# through a different address than the one people type (a proxy). Example:
# APP_URL=http://localhost:8080,https://autostock.my-shop.ma

# --- Developing (docker compose up) ---
# Port of the website on your computer: http://localhost:5173
WEB_PORT=5173
# Address people type to open the website while developing (default http://localhost:5173).
# Use https://... on a real server: login cookies are then only sent over HTTPS.
# APP_URL=http://localhost:5173

# Optional local AI for "Ask your shop" (free, runs on this computer). Start it with:
#   docker compose --profile ai-gpu up    (NVIDIA graphics card, much faster)
#   docker compose --profile ai up        (no graphics card)
# On a shop's computer, add -f docker-compose.prod.yml and -d (docs/INSTALL.md).
# About 2.5 GB. Close heavy apps (games, animated wallpapers, many browser tabs) so the model fits
# on a 4 GB graphics card; otherwise part of it runs on the processor and answers get slower.
# Chosen by measuring 5 models on 60 open questions (docs/journey.md, step 7c).
OLLAMA_MODEL=qwen3:4b-instruct

# Optional online assistant for "Ask your shop": Groq, free tier (https://console.groq.com, "API Keys").
# With a key here it is on (the owner can turn it off in Settings): Groq understands the question and
# calls the app's read-only tools; it receives the question, the conversation and the tool results,
# never the database. Every number is checked. No internet or daily limit reached: the app answers.
# Leave empty to keep everything on this computer.
GROQ_API_KEY=
