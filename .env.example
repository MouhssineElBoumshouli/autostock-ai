# Copy this file to .env and change the values. .env is never committed to git.

# Database login (used by the db and api services).
POSTGRES_USER=autostock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autostock

# Port of the website on your computer: http://localhost:5173
WEB_PORT=5173

# Address people type to open the website. Must match WEB_PORT locally.
# Use https://... on a real server: login cookies are then only sent over HTTPS.
APP_URL=http://localhost:5173

# Optional local AI for "Ask your shop" (free, runs on this computer). Start it with:
#   docker compose --profile ai-gpu up    (NVIDIA graphics card, much faster)
#   docker compose --profile ai up        (no graphics card)
# About 2.5 GB. Close heavy apps (games, animated wallpapers, many browser tabs) so the model fits
# on a 4 GB graphics card; otherwise part of it runs on the processor and answers get slower.
# Chosen by measuring 5 models on 60 open questions (docs/journey.md, step 7c).
OLLAMA_MODEL=qwen3:4b-instruct
