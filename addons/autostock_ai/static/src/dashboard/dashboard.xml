<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="autostock_ai.Dashboard">
        <main class="as-app" t-on-keydown="onShellKeydown">
            <button t-if="state.mobileView &amp;&amp; state.navOpen" class="as-nav-scrim" type="button" aria-label="Close AutoStock navigation" t-on-click="closeMobileNav"/>
            <aside id="as-mobile-nav" t-ref="mobileNavDrawer" t-att-class="state.navOpen ? 'as-sidebar as-sidebar-open' : 'as-sidebar'" t-att-role="state.mobileView &amp;&amp; state.navOpen ? 'dialog' : 'complementary'" t-att-aria-modal="state.mobileView &amp;&amp; state.navOpen ? 'true' : 'false'" aria-label="AutoStock AI navigation" tabindex="-1">
                <div class="as-sidebar-brand-row">
                <a class="as-brand" href="/web" aria-label="AutoStock AI, return to Odoo home">
                    <span class="as-brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 3 29 26H3L16 3Zm0 7-8 14h16L16 10Zm0 6 4 8h-8l4-8Z"/></svg></span>
                    <span class="as-brand-copy"><strong>AutoStock <b>AI</b></strong><small>Inventory intelligence</small></span>
                </a>
                <button t-if="state.mobileView" type="button" class="as-mobile-close" aria-label="Close navigation" t-on-click="closeMobileNav"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
                </div>
                <div class="as-company-card" title="The active company is changed in Odoo's company menu above.">
                    <img t-if="state.forecastOptions" class="as-company-logo" t-att-src="state.forecastOptions.company_logo_url" t-att-alt="state.forecastOptions.company_name + ' logo'"/>
                    <span class="as-company-copy"><small>ACTIVE COMPANY</small><strong t-esc="state.forecastOptions ? state.forecastOptions.company_name : 'Loading company'"/></span>
                </div>
                <nav class="as-primary-nav" aria-label="Workspace">
                    <span class="as-nav-label">WORKSPACE</span>
                    <button type="button" t-att-class="state.activeSection === 'dashboard' ? 'as-nav-item is-active' : 'as-nav-item'" t-att-aria-current="state.activeSection === 'dashboard' ? 'page' : false" t-on-click="scrollToDashboard">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z"/></svg><span>Dashboard</span>
                    </button>
                    <button type="button" class="as-nav-item" t-on-click="openProducts">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5"/></svg><span>Inventory</span>
                    </button>
                    <button type="button" t-att-class="state.activeSection === 'forecast' ? 'as-nav-item is-active' : 'as-nav-item'" t-att-aria-current="state.activeSection === 'forecast' ? 'location' : false" t-on-click="scrollToForecast">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18 9 12l4 4 8-9M16 7h5v5"/></svg><span>Forecasts</span>
                    </button>
                </nav>
                <div class="as-sidebar-footer">
                    <span t-att-class="'as-sidebar-status is-' + state.connectionStatus" role="status" aria-live="polite">
                        <i aria-hidden="true"/>
                        <t t-if="state.connectionStatus === 'connected'">Connected to Odoo</t>
                        <t t-elif="state.connectionStatus === 'connecting'">Connecting to Odoo</t>
                        <t t-else="">Odoo connection unavailable</t>
                    </span>
                    <small>Stock records and company access stay in Odoo.</small>
                </div>
            </aside>
            <div class="as-content-column">
                <header class="as-appbar">
                    <button t-if="state.mobileView" t-ref="mobileMenuButton" class="as-menu-toggle" type="button" aria-controls="as-mobile-nav" t-att-aria-expanded="state.navOpen ? 'true' : 'false'" aria-label="Open AutoStock navigation" t-on-click="toggleMobileNav">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                    </button>
                    <div class="as-appbar-context"><span>AutoStock AI</span><i aria-hidden="true">/</i><strong>Dashboard</strong></div>
                    <div class="as-appbar-company" t-if="state.forecastOptions">
                        <span class="as-company-caption">Company</span><strong t-esc="state.forecastOptions.company_name"/>
                    </div>
                </header>
                <div class="as-page-scroll" t-ref="dashboardScroll">
                    <div class="as-page-content">
            <header class="as-topline">
                <div class="as-heading-group">
                    <div class="as-eyebrow">AUTOSTOCK AI <span aria-hidden="true">/</span> INVENTORY INTELLIGENCE</div>
                    <h1 class="as-title">Dashboard</h1>
                    <p class="as-subtitle">A clear, current view of your automotive inventory.</p>
                </div>
                <div class="as-toolbar" aria-label="Dashboard actions">
                    <button class="as-btn as-btn-secondary" type="button" t-on-click="load" t-att-disabled="state.loading" aria-label="Refresh inventory data">
                        <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4.7 9a7.5 7.5 0 0 1 12.6-2L20 12M4 17v-5h5m10.3 3a7.5 7.5 0 0 1-12.6 2L4 12"/></svg>
                        <span>Refresh</span>
                    </button>
                    <button class="as-btn as-btn-primary" type="button" t-on-click="openProducts">
                        <span>View inventory</span>
                        <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                    </button>
                </div>
            </header>

            <t t-if="state.loading">
                <div class="as-centered" role="status" aria-live="polite">
                    <span class="as-spinner" aria-hidden="true"></span>
                    <span>Loading your inventory…</span>
                </div>
            </t>
            <t t-elif="state.error">
                <section class="as-error" role="alert">
                    <div class="as-state-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Zm0 6v4m0 3h.01"/></svg>
                    </div>
                    <div class="as-state-copy">
                        <h2>We couldn't load your dashboard</h2>
                        <p t-esc="state.error"/>
                    </div>
                    <button class="as-btn as-btn-primary" type="button" t-on-click="load">Try again</button>
                </section>
            </t>
            <t t-elif="state.data">
                <div class="as-data-note" role="status">
                    <span class="as-live-dot" aria-hidden="true"></span>
                    <span>Live Odoo inventory data</span>
                    <span class="as-separator" aria-hidden="true">·</span>
                    <span>Updated <time t-esc="state.data.as_of"/></span>
                </div>

                <t t-if="state.data.summary_incomplete">
                    <div class="as-warning" role="status">
                        <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 19h18.4L12 3Zm0 6v4m0 3h.01"/></svg>
                        <span>Showing a limited sample of 5,000 tracked products out of <strong t-esc="state.data.total_tracked"/>. The counts below describe the sample, not the full inventory.</span>
                    </div>
                </t>

                <section class="as-kpis" aria-label="Stock overview">
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-purple" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 9 8-4.5M12 12 4 7.5m8 4.5v9"/></svg></span>
                            <span>Tracked SKUs</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.total"/></strong>
                        <small>Products included in AutoStock AI</small>
                    </article>
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5"/></svg></span>
                            <span>Above safety stock</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.healthy"/></strong>
                        <small>On hand above the manual threshold</small>
                    </article>
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Zm0 6v4m0 3h.01"/></svg></span>
                            <span>Low stock</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.low"/></strong>
                        <small>At or below a manual safety threshold</small>
                    </article>
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-red" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4h.01"/></svg></span>
                            <span>Out of stock</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.out"/></strong>
                        <small>On hand is zero or below</small>
                    </article>
                </section>

                <t t-if="!state.data.kpis.total">
                    <section class="as-onboarding" aria-labelledby="as-onboarding-title">
                        <div class="as-onboarding-head">
                            <span class="as-onboarding-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM8 7V4h8v3m-8 5h8m-8 4h5"/></svg></span>
                            <div><span class="as-section-kicker">GETTING STARTED</span><h2 id="as-onboarding-title">Set up your first stock review</h2><p>Three short steps connect your parts catalog to a useful forecast.</p></div>
                        </div>
                        <ol class="as-onboarding-steps">
                            <li><span>1</span><div><strong>Choose the parts to track</strong><small>Start with active automotive items in your Odoo catalog.</small></div></li>
                            <li><span>2</span><div><strong>Confirm history coverage</strong><small>Use completed customer deliveries and verify when the history is complete.</small></div></li>
                            <li><span>3</span><div><strong>Review a forecast</strong><small>Compare the evidence and limitations before making a decision.</small></div></li>
                        </ol>
                        <div class="as-onboarding-actions">
                            <button class="as-btn as-btn-primary" type="button" t-on-click="openProducts">Choose parts <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></button>
                            <button class="as-btn as-btn-secondary" type="button" t-on-click="scrollToForecast">Explore synthetic demo</button>
                        </div>
                    </section>
                </t>

                <section class="as-panels" aria-label="Forecast and inventory health">
                    <article class="as-card as-forecast-panel" data-as-section="forecast" t-ref="chartFrame">
                        <div class="as-panel-head">
                            <div>
                                <span class="as-section-kicker">EVALUATED DEMAND</span>
                                <h2 tabindex="-1">Daily fulfilled sales forecast</h2>
                                <p>Chronological evaluation compares a trained model with transparent baselines.</p>
                            </div>
                            <span class="as-pill as-pill-planned" t-esc="forecastStateLabel"/>
                        </div>
                        <form class="as-forecast-form" t-on-submit.prevent="submitForecast" aria-label="Forecast filters">
                            <label class="as-filter-field">
                                <span>Data source</span>
                                <select t-model="state.filters.sourceType" t-on-change="changeSource" t-att-disabled="state.forecastBusy">
                                    <option value="synthetic_demo">Synthetic demo</option>
                                    <option value="completed_deliveries" t-att-disabled="!state.forecastOptions.can_forecast_real">Completed Odoo deliveries</option>
                                </select>
                            </label>
                            <label class="as-filter-field as-filter-span">
                                <span t-if="state.filters.sourceType === 'synthetic_demo'">Synthetic SKU</span>
                                <span t-else="">Tracked part / SKU</span>
                                <select t-if="state.filters.sourceType === 'synthetic_demo'" t-model="state.filters.sku" t-on-change="loadForecastSnapshot" t-att-disabled="state.forecastBusy">
                                    <option t-foreach="state.forecastOptions.demo_skus" t-as="sample" t-key="sample.sku" t-att-value="sample.sku" t-esc="sample.name"/>
                                </select>
                                <select t-else="" t-key="'odoo-products-' + state.forecastOptions.company_id" t-model="state.filters.productId" t-on-change="changeProduct" t-att-disabled="state.forecastBusy || !state.forecastOptions.products.length">
                                    <option value="">Choose a tracked part</option>
                                    <option t-foreach="state.forecastOptions.products" t-as="product" t-key="product.id" t-att-value="product.id" t-esc="product.sku + ' · ' + product.name"/>
                                </select>
                            </label>
                            <label t-if="state.filters.sourceType === 'completed_deliveries'" class="as-filter-field as-filter-span">
                                <span>Warehouse <small>(optional)</small></span>
                                <select t-model="state.filters.warehouseId" t-on-change="changeWarehouse" t-att-disabled="state.forecastBusy">
                                    <option value="">All warehouses in <t t-esc="state.forecastOptions.company_name"/></option>
                                    <option t-foreach="state.forecastOptions.warehouses" t-as="warehouse" t-key="warehouse.id" t-att-value="warehouse.id" t-esc="warehouse.name"/>
                                </select>
                            </label>
                            <label class="as-filter-field">
                                <span>History from <small>UTC</small></span>
                                <input type="date" t-model="state.filters.historyStart" t-on-change="loadForecastSnapshot" t-att-max="state.filters.historyEnd" t-att-disabled="state.forecastBusy" required="required"/>
                            </label>
                            <label class="as-filter-field">
                                <span>History through <small>UTC</small></span>
                                <input type="date" t-model="state.filters.historyEnd" t-on-change="loadForecastSnapshot" t-att-max="state.forecastOptions.today_utc" t-att-min="state.filters.historyStart" t-att-disabled="state.forecastBusy" required="required"/>
                            </label>
                            <label class="as-filter-field">
                                <span>Horizon</span>
                                <select t-model="state.filters.horizon" t-on-change="loadForecastSnapshot" t-att-disabled="state.forecastBusy">
                                    <option value="7">7 days</option>
                                    <option value="30">30 days</option>
                                    <option value="60">60 days</option>
                                </select>
                            </label>
                            <div class="as-forecast-submit">
                                <button class="as-btn as-btn-primary" type="submit" t-att-disabled="state.forecastBusy || (state.filters.sourceType === 'completed_deliveries' &amp;&amp; (!state.forecastOptions.can_forecast_real || !state.filters.productId))">
                                    <span t-if="state.forecastBusy">Evaluating…</span>
                                    <span t-elif="state.filters.sourceType === 'synthetic_demo'">Run synthetic demo</span>
                                    <span t-else="">Evaluate Odoo history</span>
                                    <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h16M7 15l4-4 3 2 5-6m-4 0h4v4"/></svg>
                                </button>
                            </div>
                        </form>

                        <div t-if="state.filters.sourceType === 'synthetic_demo'" class="as-forecast-notice as-notice-demo" role="note">
                            Synthetic sample only. This deterministic demo does not read Odoo transactions, stock, supplier records, or customer data.
                        </div>
                        <div t-elif="!state.forecastOptions.can_forecast_real" class="as-forecast-notice" role="note">
                            Odoo delivery forecasts require both Inventory and Sales access. Synthetic demos remain available with Inventory access.
                        </div>
                        <div t-elif="!selectedCoverageStart" class="as-forecast-notice" role="note">
                            Configure and verify a complete-history start date for <strong t-esc="selectedWarehouse ? selectedWarehouse.name : state.forecastOptions.company_name"/> before forecasting Odoo deliveries.
                        </div>

                        <div t-if="state.forecastError" class="as-forecast-error" role="alert" t-esc="state.forecastError"/>
                        <div t-if="state.forecastNotice" class="as-forecast-notice" role="status" t-esc="state.forecastNotice"/>

                        <t t-if="state.forecastBusy &amp;&amp; ['queued', 'running'].includes(state.forecast?.state)">
                            <div class="as-forecast-progress" role="status" aria-live="polite">
                                <span class="as-spinner" aria-hidden="true"/>
                                <span>Forecast job queued for the background worker. Your browser is not training a model.</span>
                            </div>
                        </t>
                        <t t-elif="state.forecast &amp;&amp; ['queued', 'running'].includes(state.forecast.state)">
                            <div class="as-forecast-progress" role="status">
                                <span class="as-spinner" aria-hidden="true"/>
                                <span>Forecast is <strong t-esc="forecastStateLabel.toLowerCase()"/>. Refresh results shortly.</span>
                            </div>
                        </t>
                        <t t-elif="state.forecast &amp;&amp; state.forecast.state === 'completed' &amp;&amp; forecastChart">
                            <div class="as-forecast-result-head">
                                <div>
                                    <span class="as-section-kicker" t-esc="state.forecast.source_label"/>
                                    <h3><t t-esc="state.forecast.sku"/> · <t t-esc="state.forecast.horizon_days"/> day outlook</h3>
                                    <p><t t-esc="state.forecast.history_start"/> — <t t-esc="state.forecast.history_end"/> UTC · <t t-esc="state.forecast.history_days"/> daily observations</p>
                                </div>
                                <span t-if="state.forecast.source_type === 'synthetic_demo'" class="as-pill as-pill-demo">SYNTHETIC DATA</span>
                                <span t-else="" class="as-pill as-pill-real">ODOO HISTORY</span>
                            </div>
                            <div class="as-chart-controls">
                                <span>History shown</span>
                                <div class="as-chart-range" role="group" aria-label="History displayed in chart">
                                    <button type="button" data-days="30" t-att-class="state.chartWindowDays === 30 ? 'is-selected' : ''" t-att-aria-pressed="state.chartWindowDays === 30 ? 'true' : 'false'" t-on-click="changeChartWindow">30 days</button>
                                    <button type="button" data-days="90" t-att-class="state.chartWindowDays === 90 ? 'is-selected' : ''" t-att-aria-pressed="state.chartWindowDays === 90 ? 'true' : 'false'" t-on-click="changeChartWindow">90 days</button>
                                    <button type="button" data-days="full" t-att-class="state.chartWindowDays === 'full' ? 'is-selected' : ''" t-att-aria-pressed="state.chartWindowDays === 'full' ? 'true' : 'false'" t-on-click="changeChartWindow">Full</button>
                                </div>
                                <span class="as-chart-window-label"><t t-esc="forecastChart.visibleHistoryDays"/> of <t t-esc="forecastChart.totalHistoryDays"/> days</span>
                            </div>
                            <figure class="as-forecast-figure" aria-labelledby="as-forecast-chart-title">
                                <svg class="as-forecast-chart" t-att-viewBox="forecastChart.viewBox" role="img" t-att-aria-label="forecastChart.accessibleLabel">
                                    <title id="as-forecast-chart-title">Historical fulfilled sales and forecast</title>
                                    <desc>Daily delivered units followed by the selected baseline or model forecast. The vertical dashed line marks the history cutoff. The shaded range is heuristic, not a confidence interval. The full daily series remains available in the data table.</desc>
                                    <line t-att-x1="forecastChart.left" y1="20" t-att-x2="forecastChart.left" y2="174" class="as-chart-axis"/>
                                    <line t-att-x1="forecastChart.left" y1="174" t-att-x2="forecastChart.right" y2="174" class="as-chart-axis"/>
                                    <g t-foreach="forecastChart.valueTicks" t-as="tick" t-key="'value-' + tick.label">
                                        <line t-att-x1="forecastChart.left" t-att-y1="tick.y" t-att-x2="forecastChart.right" t-att-y2="tick.y" class="as-chart-gridline"/>
                                        <text x="48" t-att-y="tick.labelY" text-anchor="end" class="as-chart-label" t-esc="tick.label"/>
                                    </g>
                                    <path t-att-d="forecastChart.forecastBand" class="as-chart-band"/>
                                    <path t-att-d="forecastChart.historyPath" class="as-chart-history"/>
                                    <path t-att-d="forecastChart.forecastPath" class="as-chart-prediction"/>
                                    <line t-att-x1="forecastChart.cutoffX" y1="20" t-att-x2="forecastChart.cutoffX" y2="174" class="as-chart-edge"/>
                                    <text t-foreach="forecastChart.dateTicks" t-as="tick" t-key="'date-' + tick.date" t-att-x="tick.x" y="202" text-anchor="middle" class="as-chart-date"><title t-esc="tick.date"/><t t-esc="tick.label"/></text>
                                </svg>
                                <figcaption class="as-chart-legend">
                                    <span><i class="as-legend-line as-legend-history" aria-hidden="true"/>Historical delivered units</span>
                                    <span><i class="as-legend-line as-legend-forecast" aria-hidden="true"/>Forecast</span>
                                    <span><i class="as-legend-band" aria-hidden="true"/>Heuristic range</span>
                                </figcaption>
                            </figure>

                            <div class="as-forecast-summary" aria-label="Forecast evaluation details">
                                <div><span>Selected method</span><strong t-esc="state.forecast.selected_method"/></div>
                                <div><span>Baseline</span><strong t-esc="state.forecast.baseline_method"/></div>
                                <div><span>Baseline MAE</span><strong><t t-esc="state.forecast.baseline_mae"/> <t t-esc="state.forecast.uom"/></strong></div>
                                <div t-if="state.forecast.ml_evaluated"><span>Random forest MAE</span><strong><t t-esc="state.forecast.ml_mae"/> <t t-esc="state.forecast.uom"/></strong></div>
                                <div><span>Demand pattern</span><strong t-esc="state.forecast.demand_pattern"/></div>
                                <div><span>Measured holdout</span><strong><t t-esc="state.forecast.evaluation_days"/> / <t t-esc="state.forecast.horizon_days"/> days</strong></div>
                                <div><span>Evaluation status</span><strong t-esc="state.forecast.evaluation_status"/></div>
                            </div>
                            <p t-if="state.forecast.evaluation_days &lt; state.forecast.horizon_days" class="as-interval-note" role="note">
                                This forecast extends beyond the measured holdout by <t t-esc="state.forecast.horizon_days - state.forecast.evaluation_days"/> days; those days have no holdout evidence.
                            </p>
                            <p class="as-interval-note" t-esc="state.forecast.interval_note"/>

                            <details class="as-forecast-details">
                                <summary>Review source, assumptions, and daily values</summary>
                                <dl class="as-source-details">
                                    <dt>Model and version</dt><dd><t t-esc="state.forecast.model_version"/> · <t t-esc="state.forecast.selected_method"/></dd>
                                    <dt>Source cutoff</dt><dd><t t-esc="state.forecast.source_cutoff"/> UTC</dd>
                                    <dt>Data provenance</dt><dd t-esc="state.forecast.data_provenance"/>
                                    <dt>Assumptions</dt><dd t-esc="state.forecast.assumptions"/>
                                    <dt>Limitations</dt><dd t-esc="state.forecast.limitations"/>
                                </dl>
                                <div class="as-table-scroll as-forecast-table-scroll" role="region" aria-label="Historical and forecast daily values" tabindex="0">
                                    <table class="as-table as-forecast-table">
                                        <caption class="as-visually-hidden">Daily historical completed delivery units and future forecast values in the product unit. Returns are separate audit events.</caption>
                                        <thead><tr><th scope="col">UTC date</th><th scope="col">Series</th><th scope="col">Delivered / forecast</th><th scope="col">Returns, separate</th><th scope="col">Heuristic range</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="state.forecast.observations" t-as="point" t-key="'actual-' + point.day">
                                                <td t-esc="point.day"/><td>Actual</td><td t-esc="point.units"/><td t-esc="point.returned_units"/><td>—</td>
                                            </tr>
                                            <tr t-foreach="state.forecast.predictions" t-as="point" t-key="'forecast-' + point.day">
                                                <td t-esc="point.day"/><td>Forecast</td><td t-esc="point.units"/><td>—</td><td><t t-esc="point.lower_heuristic"/> – <t t-esc="point.upper_heuristic"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </details>

                            <div t-if="state.forecast.current_stock" class="as-stock-separation" role="note">
                                <strong>Current Odoo stock</strong>
                                <span>On hand: <b t-esc="state.forecast.current_stock.on_hand"/> <t t-esc="state.forecast.current_stock.uom"/></span>
                                <span>Odoo projected stock: <b t-esc="state.forecast.current_stock.odoo_projected"/> <t t-esc="state.forecast.current_stock.uom"/></span>
                                <small>Projected stock comes from Odoo's known operations; it is not the demand forecast above.</small>
                            </div>
                        </t>
                        <t t-elif="state.forecast &amp;&amp; ['insufficient_history', 'no_observed_demand', 'failed'].includes(state.forecast.state)">
                            <div class="as-forecast-empty" role="status">
                                <span class="as-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Zm0 6v4m0 3h.01"/></svg></span>
                                <h3 t-esc="forecastStateLabel"/>
                                <p t-esc="state.forecast.failure_reason || 'No numeric forecast was produced for this history.'"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="as-forecast-empty" role="status">
                                <span class="as-empty-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M7 15l4-4 3 2 5-6m-4 0h4v4"/></svg></span>
                                <h3>No forecast run for these filters</h3>
                                <p>Choose a SKU, date range, and horizon. The initial demo uses generated synthetic history and displays its provenance on every run.</p>
                            </div>
                        </t>
                    </article>

                    <article class="as-card as-health-panel">
                        <div class="as-panel-head">
                            <div><span class="as-section-kicker">CURRENT STOCK</span><h2>Inventory health</h2><p>Classified from Odoo on-hand quantity.</p></div>
                        </div>
                        <t t-if="state.data.kpis.total">
                            <div class="as-health-summary" t-att-style="healthStyle" role="img" t-att-aria-label="'Above safety stock: ' + state.data.kpis.healthy + ', low stock: ' + state.data.kpis.low + ', out of stock: ' + state.data.kpis.out">
                                <div class="as-health-center"><strong><t t-esc="state.data.kpis.total"/></strong><small>Tracked SKUs</small></div>
                            </div>
                            <div class="as-health-lines" aria-label="Stock status counts">
                                <div><span><i class="as-dot as-dot-green" aria-hidden="true"/> Above safety stock</span><strong t-esc="state.data.kpis.healthy"/></div>
                                <div><span><i class="as-dot as-dot-amber" aria-hidden="true"/> Low stock</span><strong t-esc="state.data.kpis.low"/></div>
                                <div><span><i class="as-dot as-dot-red" aria-hidden="true"/> Out of stock</span><strong t-esc="state.data.kpis.out"/></div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="as-health-empty" role="status">
                                <span class="as-health-empty-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM8 7V4h8v3m-8 5h8"/></svg></span>
                                <h3>Inventory health starts with tracked parts</h3>
                                <p>When parts are enabled, this panel will classify live Odoo on-hand stock against each manual safety-stock threshold.</p>
                                <button type="button" class="as-link" t-on-click="openProducts">Browse the product catalog</button>
                            </div>
                        </t>
                    </article>
                </section>

                <section class="as-card as-table-panel" data-as-section="inventory" aria-labelledby="as-inventory-title">
                    <div class="as-panel-head">
                        <div><span class="as-section-kicker">LIVE ODOO DATA</span><h2 id="as-inventory-title">Automotive inventory</h2><p>On-hand and projected quantities come from Odoo; projected stock is not an AI forecast.</p></div>
                        <button type="button" class="as-link" t-on-click="openProducts">
                            View all products
                            <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                        </button>
                    </div>
                    <div class="as-table-hint" aria-hidden="true">Swipe or scroll horizontally to see all columns</div>
                    <div class="as-table-scroll" role="region" aria-label="Tracked automotive inventory" tabindex="0">
                        <table class="as-table">
                            <caption class="as-visually-hidden">Current Odoo stock quantities and manual safety-stock classifications for tracked products.</caption>
                            <thead><tr><th scope="col">Part</th><th scope="col">SKU</th><th scope="col">OEM reference</th><th scope="col">On hand</th><th scope="col">Odoo projected</th><th scope="col">Status</th><th scope="col">Details</th></tr></thead>
                            <tbody>
                                <t t-foreach="state.data.rows" t-as="part" t-key="part.id">
                                    <tr>
                                        <td class="as-part-name"><t t-esc="part.name"/></td>
                                        <td><t t-esc="part.sku"/></td>
                                        <td><t t-esc="part.reference"/></td>
                                        <td class="as-number"><t t-esc="part.on_hand"/></td>
                                        <td class="as-number"><t t-esc="part.odoo_projected"/></td>
                                        <td><span t-att-class="'as-status as-status-' + part.status" t-esc="part.status_label"/></td>
                                        <td><button type="button" class="as-link" t-att-data-product-template-id="part.template_id" t-on-click="openProduct">Open <span aria-hidden="true">↗</span></button></td>
                                    </tr>
                                </t>
                                <t t-if="!state.data.rows.length">
                                    <tr><td colspan="7" class="as-table-empty">No tracked products to display. Browse all products to choose which parts to include.</td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>

                <footer class="as-footer">AutoStock AI · Evaluated demand forecast · Live inventory and company rules from Odoo</footer>
            </t>
                    </div>
                </div>
            </div>
        </main>
    </t>
</templates>
