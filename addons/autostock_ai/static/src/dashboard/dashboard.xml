<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="autostock_ai.Dashboard">
        <main class="as-app">
            <header class="as-topline">
                <div class="as-heading-group">
                    <div class="as-eyebrow">BOUNAIM AUTO <span aria-hidden="true">/</span> INVENTORY INTELLIGENCE</div>
                    <h1 class="as-title">Dashboard</h1>
                    <p class="as-subtitle">A clear, current view of your automotive inventory.</p>
                </div>
                <div class="as-toolbar" aria-label="Dashboard actions">
                    <button class="as-btn as-btn-secondary" type="button" t-on-click="load" t-att-disabled="state.loading" aria-label="Refresh inventory data">
                        <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4.7 9a7.5 7.5 0 0 1 12.6-2L20 12M4 17v-5h5m10.3 3a7.5 7.5 0 0 1-12.6 2L4 12"/></svg>
                        <span>Refresh</span>
                    </button>
                    <button class="as-btn as-btn-primary" type="button" t-on-click="openProducts">
                        <span>View inventory</span>
                        <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                    </button>
                </div>
            </header>

            <t t-if="state.loading">
                <div class="as-centered" role="status" aria-live="polite">
                    <span class="as-spinner" aria-hidden="true"></span>
                    <span>Loading your inventory…</span>
                </div>
            </t>
            <t t-elif="state.error">
                <section class="as-error" role="alert">
                    <div class="as-state-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Zm0 6v4m0 3h.01"/></svg>
                    </div>
                    <div class="as-state-copy">
                        <h2>We couldn't load your dashboard</h2>
                        <p t-esc="state.error"/>
                    </div>
                    <button class="as-btn as-btn-primary" type="button" t-on-click="load">Try again</button>
                </section>
            </t>
            <t t-elif="state.data">
                <div class="as-data-note" role="status">
                    <span class="as-live-dot" aria-hidden="true"></span>
                    <span>Live Odoo inventory data</span>
                    <span class="as-separator" aria-hidden="true">·</span>
                    <span>Updated <time t-esc="state.data.as_of"/></span>
                </div>

                <t t-if="state.data.summary_incomplete">
                    <div class="as-warning" role="status">
                        <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 19h18.4L12 3Zm0 6v4m0 3h.01"/></svg>
                        <span>Showing a limited sample of 5,000 tracked products out of <strong t-esc="state.data.total_tracked"/>. The counts below describe the sample, not the full inventory.</span>
                    </div>
                </t>

                <section class="as-kpis" aria-label="Stock overview">
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-purple" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 9 8-4.5M12 12 4 7.5m8 4.5v9"/></svg></span>
                            <span>Tracked SKUs</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.total"/></strong>
                        <small>Products included in AutoStock AI</small>
                    </article>
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5"/></svg></span>
                            <span>Above safety stock</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.healthy"/></strong>
                        <small>On hand above the manual threshold</small>
                    </article>
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-amber" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 19h18.4L12 3Zm0 6v4m0 3h.01"/></svg></span>
                            <span>Low stock</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.low"/></strong>
                        <small>At or below a manual safety threshold</small>
                    </article>
                    <article class="as-card as-kpi">
                        <div class="as-kpi-heading">
                            <span class="as-kpi-icon as-red" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v6m0 4h.01"/></svg></span>
                            <span>Out of stock</span>
                        </div>
                        <strong><t t-esc="state.data.kpis.out"/></strong>
                        <small>On hand is zero or below</small>
                    </article>
                </section>

                <t t-if="!state.data.kpis.total">
                    <section class="as-first-step" role="status">
                        <div class="as-first-step-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM8 7V4h8v3m-8 5h8m-8 4h5"/></svg>
                        </div>
                        <div class="as-first-step-copy">
                            <span class="as-section-kicker">GETTING STARTED</span>
                            <h2>No parts are being tracked yet</h2>
                            <p>Open your product catalog and enable “Track in AutoStock AI” on the parts you want to review. Stock values will appear here after they are tracked.</p>
                        </div>
                        <button class="as-btn as-btn-secondary" type="button" t-on-click="openProducts">
                            Browse products
                            <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                        </button>
                    </section>
                </t>

                <section class="as-panels" aria-label="Forecast and inventory health">
                    <article class="as-card as-forecast-panel">
                        <div class="as-panel-head">
                            <div>
                                <span class="as-section-kicker">PLANNED CAPABILITY</span>
                                <h2>AI demand forecast</h2>
                                <p>Forecasts will be shown after model evaluation and Odoo integration.</p>
                            </div>
                            <span class="as-pill as-pill-planned">Not connected</span>
                        </div>
                        <div class="as-chart-empty" role="status">
                            <div class="as-chart-grid" aria-hidden="true"></div>
                            <div class="as-empty-message">
                                <span class="as-empty-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M7 15l4-4 3 2 5-6m-4 0h4v4"/></svg>
                                </span>
                                <h3>Forecasts aren't connected yet</h3>
                                <p>The offline forecasting experiment is not linked to Odoo. No sample predictions or accuracy claims are shown here.</p>
                            </div>
                        </div>
                    </article>

                    <article class="as-card as-health-panel">
                        <div class="as-panel-head">
                            <div><span class="as-section-kicker">CURRENT STOCK</span><h2>Inventory health</h2><p>Classified from Odoo on-hand quantity.</p></div>
                        </div>
                        <div class="as-health-summary" t-att-style="healthStyle" role="img" t-att-aria-label="'Above safety stock: ' + state.data.kpis.healthy + ', low stock: ' + state.data.kpis.low + ', out of stock: ' + state.data.kpis.out">
                            <div class="as-health-center">
                                <strong><t t-esc="state.data.kpis.total"/></strong>
                                <small>Tracked SKUs</small>
                            </div>
                        </div>
                        <div class="as-health-lines" aria-label="Stock status counts">
                            <div><span><i class="as-dot as-dot-green" aria-hidden="true"></i> Above safety stock</span><strong t-esc="state.data.kpis.healthy"/></div>
                            <div><span><i class="as-dot as-dot-amber" aria-hidden="true"></i> Low stock</span><strong t-esc="state.data.kpis.low"/></div>
                            <div><span><i class="as-dot as-dot-red" aria-hidden="true"></i> Out of stock</span><strong t-esc="state.data.kpis.out"/></div>
                        </div>
                    </article>
                </section>

                <section class="as-card as-insights" aria-labelledby="as-planned-title">
                    <div class="as-panel-head">
                        <div><span class="as-section-kicker">ROADMAP</span><h2 id="as-planned-title">Planned decision tools</h2><p>These capabilities are not available in this foundation release.</p></div>
                        <span class="as-pill as-pill-planned">In development</span>
                    </div>
                    <div class="as-insight-grid">
                        <article class="as-insight-card">
                            <span class="as-insight-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M7 15l4-4 3 2 5-6"/></svg></span>
                            <h3>Demand forecasting</h3>
                            <p>Evaluated forecasts with history coverage, baseline comparisons and uncertainty notes.</p>
                        </article>
                        <article class="as-insight-card">
                            <span class="as-insight-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM8 7V4h8v3m-8 5h8m-8 4h5"/></svg></span>
                            <h3>Replenishment review</h3>
                            <p>Human-reviewed proposals based on evaluated demand and confirmed Odoo stock.</p>
                        </article>
                        <article class="as-insight-card">
                            <span class="as-insight-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18m9-9H3m15.4-6.4L5.6 18.4m12.8 0L5.6 5.6"/></svg></span>
                            <h3>Scenario analysis</h3>
                            <p>Explore demand and supplier changes without mutating live inventory or orders.</p>
                        </article>
                    </div>
                </section>

                <section class="as-card as-table-panel" aria-labelledby="as-inventory-title">
                    <div class="as-panel-head">
                        <div><span class="as-section-kicker">LIVE ODOO DATA</span><h2 id="as-inventory-title">Automotive inventory</h2><p>On-hand and projected quantities come from Odoo; projected stock is not an AI forecast.</p></div>
                        <button type="button" class="as-link" t-on-click="openProducts">
                            View all products
                            <svg class="as-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
                        </button>
                    </div>
                    <div class="as-table-hint" aria-hidden="true">Swipe or scroll horizontally to see all columns</div>
                    <div class="as-table-scroll" role="region" aria-label="Tracked automotive inventory" tabindex="0">
                        <table class="as-table">
                            <caption class="as-visually-hidden">Current Odoo stock quantities and manual safety-stock classifications for tracked products.</caption>
                            <thead><tr><th scope="col">Part</th><th scope="col">SKU</th><th scope="col">OEM reference</th><th scope="col">On hand</th><th scope="col">Odoo projected</th><th scope="col">Status</th><th scope="col">Details</th></tr></thead>
                            <tbody>
                                <t t-foreach="state.data.rows" t-as="part" t-key="part.id">
                                    <tr>
                                        <td class="as-part-name"><t t-esc="part.name"/></td>
                                        <td><t t-esc="part.sku"/></td>
                                        <td><t t-esc="part.reference"/></td>
                                        <td class="as-number"><t t-esc="part.on_hand"/></td>
                                        <td class="as-number"><t t-esc="part.odoo_projected"/></td>
                                        <td><span t-att-class="'as-status as-status-' + part.status" t-esc="part.status_label"/></td>
                                        <td><button type="button" class="as-link" t-att-data-product-template-id="part.template_id" t-on-click="openProduct">Open <span aria-hidden="true">↗</span></button></td>
                                    </tr>
                                </t>
                                <t t-if="!state.data.rows.length">
                                    <tr><td colspan="7" class="as-table-empty">No tracked products to display. Browse all products to choose which parts to include.</td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </section>

                <footer class="as-footer">AutoStock AI · Foundation release · Live stock from Odoo · Forecast integration pending</footer>
            </t>
        </main>
    </t>
</templates>
