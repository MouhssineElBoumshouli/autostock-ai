<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_supplierinfo_autostock_form" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.autostock</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <label for="autostock_min_order_qty" string="AutoStock minimum order quantity"/>
                <div class="o_row">
                    <field name="autostock_min_order_qty" class="oe_inline"/>
                    <span class="text-muted">in the vendor unit above</span>
                </div>
                <div class="text-muted">
                    This supplier minimum is separate from the native minimum quantity price break.
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_product_supplierinfo_autostock_list" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.autostock</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='min_qty']" position="after">
                <field name="autostock_min_order_qty" string="AutoStock MOQ" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
