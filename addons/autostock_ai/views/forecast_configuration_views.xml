<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_autostock_history" model="ir.ui.view">
        <field name="name">res.company.form.autostock.history</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AutoStock AI" name="autostock_history" groups="base.group_system">
                    <group>
                        <field name="autostock_history_complete_from"/>
                    </group>
                    <div class="text-muted">
                        Set this only after verifying that completed delivery and return history is complete from this UTC date.
                        Forecasts are refused for earlier dates.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_form_autostock_history" model="ir.ui.view">
        <field name="name">stock.warehouse.form.autostock.history</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="AutoStock AI" groups="stock.group_stock_manager">
                    <field name="autostock_history_complete_from"/>
                    <div class="text-muted">
                        Set only after verifying warehouse-specific delivery and return history from this UTC date.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
