<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_autostock" model="ir.ui.view">
        <field name="name">product.template.form.autostock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="AutoStock AI" name="autostock_page" groups="stock.group_stock_user">
                    <group string="Automotive Inventory Intelligence">
                        <field name="autostock_enabled"/>
                        <field name="autostock_oem_reference"/>
                        <field name="autostock_priority"/>
                        <field name="autostock_safety_stock"/>
                        <field name="autostock_lead_time_days"/>
                    </group>
                    <div class="text-muted">
                        Stock-risk analysis uses live Odoo quantities and configured reorder policy.
                        Vendor minimum order quantity is maintained separately from vendor price breaks.
                        Vehicle fitment must be checked against trusted manufacturer data.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
