<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_autostock_forecast_run_company" model="ir.rule">
        <field name="name">AutoStock forecasts by allowed company</field>
        <field name="model_id" ref="model_autostock_forecast_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_autostock_forecast_observation_company" model="ir.rule">
        <field name="name">AutoStock forecast observations by allowed company</field>
        <field name="model_id" ref="model_autostock_forecast_observation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_autostock_forecast_point_company" model="ir.rule">
        <field name="name">AutoStock forecast points by allowed company</field>
        <field name="model_id" ref="model_autostock_forecast_point"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
