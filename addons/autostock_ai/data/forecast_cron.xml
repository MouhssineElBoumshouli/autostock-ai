<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_autostock_forecast_queue" model="ir.cron">
        <field name="name">AutoStock: process evaluated forecast queue</field>
        <field name="model_id" ref="model_autostock_forecast_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queued_runs()</field>
        <field name="user_id" ref="base.user_root"/>
